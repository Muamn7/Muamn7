# Imported models under a licence that forbids redistribution (see CREDITS.md).
# The game falls back to procedural assets when these are absent; run
# tools/import_assets.sh locally to regenerate them.
assets/imported/models/chapel*
assets/imported/models/wanderer*
assets/imported/models/weapon_axe*
assets/imported/models/tree*

# Runtime save files (Gdx.files.local resolves to the run working directory)
ashen-save.json*
assets/ashen-save.json*

# The sound bank is synthesised on first launch into the same local directory.
audio-cache/
assets/audio-cache/

# Blender backup files
*.blend1

# Trimble S6 model converted from 3D Warehouse (licence forbids redistribution).
# Regenerate with blender/trimble_s6/skp_to_blender.py from the original .skp.
blender/trimble_s6/*.blend
blender/trimble_s6/*.fbx
blender/trimble_s6/*.glb
blender/trimble_s6/*.obj
blender/trimble_s6/*.mtl
blender/trimble_s6/*.stl
blender/trimble_s6/*.skp
blender/trimble_s6/__pycache__/
blender/trimble_s6/print/
